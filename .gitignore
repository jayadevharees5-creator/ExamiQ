cat > .gitignore <<'EOF'
.env
.env.*
!.env.example

.DS_Store
.refact/

__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

venv/
.venv/
EOF

# Temporary development files
scratch/

# Generated indexes (keep directory placeholder)
faiss_indexes/*
!faiss_indexes/.gitkeep
data/db_store.json
